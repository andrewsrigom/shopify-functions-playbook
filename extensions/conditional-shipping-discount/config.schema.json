{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "minimum": {
      "type": "string",
      "pattern": "^\\d{1,15}(?:\\.\\d{1,6})?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "optionTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "percentage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": ["enabled", "minimum", "currency", "optionTitle", "percentage"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conditional-shipping-discount configuration",
  "description": "Unknown keys are ignored. Cross-field restrictions are documented in README and enforced by the Function."
}

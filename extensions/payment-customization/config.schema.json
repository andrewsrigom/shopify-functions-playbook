{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "maximum": {
      "type": "string",
      "pattern": "^\\d{1,15}(?:\\.\\d{1,6})?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "methodName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": ["enabled", "maximum", "currency", "methodName"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment-customization configuration",
  "description": "Unknown keys are ignored. Cross-field restrictions are documented in README and enforced by the Function."
}
